# Copy this file to .env and replace required values. Do not commit .env.
COMPOSE_PROJECT_NAME=universe

# Image repository names and a shared tag. Build commands create these locally.
IMAGE_TAG=local
CLIENT_WEB_IMAGE=universe-client-web
WEB_API_IMAGE=universe-web-api

# The web UI is loopback-only by default. Set CLIENT_WEB_BIND=0.0.0.0 only
# when the deployment environment provides appropriate access controls.
CLIENT_WEB_BIND=127.0.0.1
CLIENT_WEB_PORT=7893

# Used only with scripts/docker-stack.sh --debug-api ...
WEB_API_BIND=127.0.0.1
WEB_API_PORT=10001

# Required runtime configuration. The DSN host must be reachable from Docker;
# do not use 127.0.0.1 to mean the host machine.
WEB_API_SQLCONN=
WEB_API_AUTH_TOKEN_SECRET=
WEB_API_AUTH_TOKEN_TTL_SECONDS=604800

# Keep application and database time-zone handling consistent.
TZ=Asia/Shanghai

# Optional local endpoint used by `check` when CLIENT_WEB_BIND is not loopback.
# CLIENT_WEB_CHECK_HOST=127.0.0.1
