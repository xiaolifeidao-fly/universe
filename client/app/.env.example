# 前端只走同源相对路径 /api，由 Next 服务端转发给 app-api，留空即可。
# 只有 PWA 需要直连另一台机器的 app-api 时才填绝对地址（那时要另配 CORS）。
NEXT_PUBLIC_APP_API_BASE_URL=

# Next 服务端转发 /api 的目标，运行时读取，改完重启 next 生效，无需重新 build。
APP_API_TARGET=http://127.0.0.1:10002

# Enables visual foundation records only for local UI review. Never set in deployment.
NEXT_PUBLIC_APP_PREVIEW=false
