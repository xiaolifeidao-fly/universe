NEXT_PUBLIC_LOCALE_PREFIX=never
NEXT_PUBLIC_BASE_URL=""

APP_URL_PREFIX="/api"
# server/manager-api，默认端口 10003（见 server/manager-api/README.md）。
# 只有这一个上游：共享算力池的运营接口由 manager-api 自己出（manager-api/pkg/galaxy，
# 底层复用 service/galaxy），不再分流去 galaxy-api —— 管理端令牌和 galaxy-api 认的
# 业务 JWT 是两套，浏览器直连过去每个请求都是 not login。
SERVER_TARGET="http://127.0.0.1:10003"
