NEXT_PUBLIC_LOCALE_PREFIX=never
NEXT_PUBLIC_BASE_URL=""

# 提供者页面的安装教程里那条 git clone 用它。各部署方的插件源码放在哪儿只有自己知道，
# 不配就在页面上露出「<插件仓库地址>」占位符 —— 比默默给一个跑不通的地址好。
NEXT_PUBLIC_BRIDGE_REPO=""

APP_URL_PREFIX="/api"
# server/galaxy-api，默认端口 10004。共享池的控制台接口全部在这个服务上：
# /api/galaxy/provider/*、/api/galaxy/consumer/*、/api/galaxy/admin/*。
SERVER_TARGET="http://127.0.0.1:10004"
