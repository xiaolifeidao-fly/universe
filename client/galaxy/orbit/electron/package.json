{
  "name": "@galaxy/orbit-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Galaxy Orbit desktop application",
  "main": "dist/main.js",
  "build": {
    "appId": "com.galaxy.orbit",
    "productName": "Orbit",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop.json",
        "to": "desktop.json"
      }
    ],
    "directories": {
      "output": "../../release/orbit"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icons"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/desktop.cjs dev orbit",
    "start": "node ../../scripts/desktop.cjs start orbit",
    "build": "node ../../scripts/desktop.cjs build orbit",
    "package": "node ../../scripts/desktop.cjs package orbit",
    "typecheck": "tsc --noEmit",
    "build:electron": "node ../../scripts/build-electron.cjs orbit"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "typescript": "^5",
    "@types/node": "^20"
  }
}
