# 门户站要连的 Go 服务端（server/galaxy-consumer-api，默认端口 10005）。
# 门户只打这一组公开接口：/api/galaxy/portal/*。
SERVER_TARGET="http://127.0.0.1:10005"
APP_URL_PREFIX="/api"

# 下面这几项都是**运行时**读的：页面每次渲染现取一次 process.env
# （src/utils/site.server.ts），改完重启进程就生效，不用重新构建。
#
# 部署机上不是靠这个文件给值 —— 发布包里没有 .env，值写在 runtime.json 里，
# 由 start.sh 发给进程（启动环境里的同名变量优先）。
#
# 名字不带 NEXT_PUBLIC_ 前缀是故意的：那个前缀的变量会被 Next 在**构建时**
# 替换成字面量打进浏览器包，值定格在打包机上 —— 线上出过「控制台按钮指着
# http://127.0.0.1:17899」。旧名字（NEXT_PUBLIC_CONSOLE_URL 等）还认，但别再用了。

# 「控制台」按钮指向哪里 —— 就是使用端（Orbit）那个控制台部署的地址。
# 不配就落到 /orbit/consumer/keys（同域部署时正好对；分域部署必须配）。
# /orbit 这一段是 Orbit 的 basePath，不能省 —— 门户占着站点根。
GALAXY_CONSOLE_URL="http://127.0.0.1:17899/orbit/consumer/keys"

# 页脚与「联系我们」上的真实联系方式。不配就在页面上显示成
# [待填写] 这样的占位，而不是编一个出来。
GALAXY_CONTACT_EMAIL=""
GALAXY_CONTACT_WECHAT=""
GALAXY_DOCS_URL=""
GALAXY_ICP=""
