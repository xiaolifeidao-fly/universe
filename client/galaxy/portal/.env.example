# 门户站要连的 Go 服务端（server/galaxy-consumer-api，默认端口 10005）。
# 门户只打这一组公开接口：/api/galaxy/portal/*。
SERVER_TARGET="http://127.0.0.1:10005"
APP_URL_PREFIX="/api"

# 「控制台」按钮指向哪里 —— 就是使用端（Orbit）那个控制台部署的地址。
# 不配就落到 /consumer/keys（同域部署时正好对；分域部署必须配）。
NEXT_PUBLIC_CONSOLE_URL="http://127.0.0.1:17899/consumer/keys"

# 页脚与「联系我们」上的真实联系方式。不配就在页面上显示成
# [待填写] 这样的占位，而不是编一个出来。
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_WECHAT=""
NEXT_PUBLIC_DOCS_URL=""
NEXT_PUBLIC_ICP=""
